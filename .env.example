# Optional. Without keys the chat assistant answers from lib/data.ts only.
GEMINI_API_KEY=    # free: https://aistudio.google.com/apikey
GROQ_API_KEY=      # optional backup: https://console.groq.com/keys
# CHAT_MODEL=gemini-flash-latest

# Blog author sign-in (required to write posts at /blog/login).
BLOG_ADMIN_EMAIL=
BLOG_ADMIN_PASSWORD=     # 8+ characters; a long passphrase is best
BLOG_AUTH_SECRET=        # 32+ random characters: openssl rand -base64 32
# Optional blog storage. Without these, posts are JSON files in content/blog.
# Set them (Upstash Redis or Vercel KV) to publish from a serverless host.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Call booking (/book and the chat "Book" tab). See README → Call booking.
BOOKING_OWNER_EMAIL=          # receives the booking emails; the Google account that authorizes below
GOOGLE_CLIENT_ID=             # Google Cloud OAuth client, type "Desktop app"
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=         # written by: npm run google:auth
# BOOKING_CALENDAR_ID=primary
# BOOKING_DRY_RUN=1           # preview the booking flow without Google (nothing is scheduled)

# Public site address for sitemap.xml / robots.txt (optional; defaults to the request host).
# SITE_URL=https://your-domain.com
